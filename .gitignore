# ============================================================================
# .gitignore — MScThesis Pipeline (Stand 2026-07)
# Regel-Reihenfolge zählt: die LETZTE passende Regel gewinnt.
# Deshalb stehen die !-Ausnahmen HINTER den Typ-Regeln.
# ============================================================================

# ---- Geheimnisse: NIE committen --------------------------------------------
manifesto_apikey.txt
.env

# ---- Rohkorpus GermaParl2 ----------------------------------------------------
cwb/
*.tar.gz

# ---- Ordner-Regeln -----------------------------------------------------------
Data/*
results/*
!results/empirics/
results/empirics/*
!results/empirics/goldstandard/

# ---- Datentypen pauschal -----------------------------------------------------
*.rds
*.parquet
*.csv
*.jsonl

# ---- Eingefrorene Pflicht-Inputs zurückholen (NACH den Typ-Regeln!) ----------
!procedural_filter_decisions_v1.csv
!Data/manifesto_distributions.rds
!results/empirics/goldstandard/**

# ---- Modelle: zu groß / nicht benötigt (NACH der goldstandard-Ausnahme!) -----
model_000_gbert/
*.safetensors
*.bin
*.joblib

# ---- Nicht-Repo-Inhalte -------------------------------------------------------
An Justyna/
comparison_out/
.gitignore.txt

# ---- R / Python / IDE ---------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.RDataTmp*
.claude/
__pycache__/
*.pyc
.venv/